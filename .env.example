# Jev Arena : copie ce fichier en `.env` et remplis au moins la cle OpenRouter.

# OBLIGATOIRE : ta cle OpenRouter (https://openrouter.ai/keys). Jev et Claude Opus 5.5 sont appeles avec.
# Compte le cout reel : Jev ~0,00002 $ par decision, Opus ~0,003 $. Une session de trading de 10 min ~ 0,30 $.
OPENROUTER_API_KEY=

# FACULTATIF : compte Alpaca PAPER (https://app.alpaca.markets/paper/dashboard/overview) pour envoyer de vrais
# ordres sur un compte fictif et trader des actions US (TSLA, QQQ...). Sans ces cles, l'arene utilise un courtier
# simule sur le flux public Coinbase (BTC/USD), long et short autorises.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=
# 2e compte paper pour donner un compte distinct a Opus (sinon les deux fonds partagent le compte, separes par ordre)
ALPACA_OPUS_KEY=
ALPACA_OPUS_SECRET=

# FACULTATIF : jeton GitHub (scene leads : recherche de profils, 30 requetes/min au lieu de 10)
GITHUB_TOKEN=

# Jeton interne du conteneur Crawl4AI (n'importe quelle chaine)
CRAWL4AI_API_TOKEN=change-me

# Plafonds de depense OpenRouter par scene, en dollars (securite)
CAP_TRADING=6
CAP_TETRIS=3
CAP_LEADS=6
CAP_AVIS=5
